+{
+	gpu_wr(s, 0xc618, 0); /* TLBIALL is a command: even zero must reach MMIO. */
+	gpu_wr(s, 0xc7f0, 0xffffffffu);
+	return gpu_poll(s, 0xc7f4, 1u, 0);
