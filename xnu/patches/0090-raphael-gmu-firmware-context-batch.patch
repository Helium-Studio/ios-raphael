+static bool
+gpu_context_test(vm_offset_t s, vm_offset_t m, const ArmSmmu4KConfig *config,
+    const ArmSmmu4KResult *built)
+{
+	/* No global reset/bypass. The held CM3 and collapsed GX provide quiescence. */
+	if (gpu_rd(m, 0x14000) != 1 || gpu_rd(s, 0x20) != 0x4c017e06 ||
+	    gpu_rd(s, 0x24) != 0x20000005 || gpu_rd(s, 0x28) != 0x5555 ||
+	    (gpu_rd(s, 0) & 0x40fu) != 0x406 || gpu_rd(s, 0x48) || gpu_rd(s, 0xc058)) {
+		printf("RAPHAEL GPU: context batch refused: reset/IDs/global/fault state\n"); return true;
+	}
+	for (unsigned i = 0; i < 6; ++i) {
+		if (gpu_rd(s, 0x800 + 4 * i) & (1u << 31)) {
+			printf("RAPHAEL GPU: context batch refused: live stream%u\n", i); return true;
+		}
+	}
+	for (unsigned i = 0; i < 5; ++i) {
+		if (gpu_rd(s, 0x8000 + 0x1000 * i) & 1u) {
+			printf("RAPHAEL GPU: context batch refused: live bank%u\n", i); return true;
+		}
+	}
+	ArmSmmu4KContextConfig ctx = {.lower = config, .lower_tables = built,
+	    .id0 = gpu_rd(s, 0x20), .id2 = gpu_rd(s, 0x28), .asid = 5};
+	ArmSmmu4KContextImage old, image, readback;
+	if (ArmSmmu4KEncodeContext(&ctx, &image) != ArmSmmu4KSuccess) { return true; }
+	gpu_context_read(s, &old);
+	uint32_t actlr = gpu_rd(s, 0xc004), smr[2], s2cr[2];
+	for (unsigned i = 0; i < 2; ++i) { smr[i] = gpu_rd(s, 0x800 + 4 * i); s2cr[i] = gpu_rd(s, 0xc00 + 4 * i); }
+	printf("RAPHAEL GPU: context batch begin; CB4 ASID5 SID4/5 mask400, CM3 held reset\n");
+	int checkpoint = 0;
+	(void)tsleep(&checkpoint, PZERO, "gmuctxlog", 3 * hz);
+	for (unsigned i = 0; i < 2; ++i) { gpu_wr(s, 0xc00 + 4 * i, 2u << 16); }
+	gpu_wr(s, 0xc000, 0);
+	gpu_context_write(s, &image);
+	gpu_wr(s, 0xc004, 0x303); /* Live DT qcom,actlr for GMU SIDs. */
+	bool programmed = gpu_context_sync(s);
+	gpu_context_read(s, &readback);
+	bool disabled = readback.sctlr == 0;
+	readback.sctlr = image.sctlr;
+	programmed &= disabled && gpu_rd(s, 0xc004) == 0x303 &&
+	    ArmSmmu4KValidateContextReadback(&ctx, &readback) == ArmSmmu4KSuccess;
+	if (programmed) {
+		/* Poll faults here; no master can issue DMA or generate fault IRQs yet. */
+		gpu_wr(s, 0xc000, image.sctlr);
+		gpu_context_read(s, &readback);
+		programmed = ArmSmmu4KValidateContextReadback(&ctx, &readback) == ArmSmmu4KSuccess;
+	}
+	bool routed = programmed;
+	for (unsigned i = 0; routed && i < 2; ++i) {
+		gpu_wr(s, 0x800 + 4 * i, 0x84000004u + i);
+		routed &= gpu_rd(s, 0x800 + 4 * i) == 0x84000004u + i;
+		if (routed) { gpu_wr(s, 0xc00 + 4 * i, 4); routed &= gpu_rd(s, 0xc00 + 4 * i) == 4; }
+	}
+	routed &= !gpu_rd(s, 0xc058) && !gpu_rd(s, 0x48);
+	printf("RAPHAEL GPU: context programmed=%u routed=%u SCTLR=%#x TCR=%#x TTBR=%#llx FSR=%#x GFSR=%#x\n",
+	    programmed, routed, gpu_rd(s, 0xc000), gpu_rd(s, 0xc030), (unsigned long long)gpu_rd64(s, 0xc020), gpu_rd(s, 0xc058), gpu_rd(s, 0x48));
+	/* Quarantine before invalidating slots, then disable and drain before recycling tables. */
+	bool detached = true;
+	for (unsigned i = 0; i < 2; ++i) {
+		gpu_wr(s, 0xc00 + 4 * i, 2u << 16);
+		detached &= gpu_rd(s, 0xc00 + 4 * i) == (2u << 16);
+		gpu_wr(s, 0x800 + 4 * i, 0);
+		detached &= gpu_rd(s, 0x800 + 4 * i) == 0;
+	}
+	gpu_wr(s, 0xc000, 0);
+	bool drained = gpu_rd(s, 0xc000) == 0 && gpu_context_sync(s);
+	if (!detached || !drained) {
+		printf("RAPHAEL GPU: context rollback detached=%u drained=%u; retaining allocation\n", detached, drained);
+		return false;
+	}
+	gpu_context_write(s, &old); gpu_wr(s, 0xc004, actlr); gpu_wr(s, 0xc000, old.sctlr);
+	for (unsigned i = 0; i < 2; ++i) { gpu_wr(s, 0xc00 + 4 * i, s2cr[i]); gpu_wr(s, 0x800 + 4 * i, smr[i]); }
+	gpu_context_read(s, &readback);
+	bool restored = !memcmp(&old, &readback, sizeof(old)) && gpu_rd(s, 0xc004) == actlr;
+	for (unsigned i = 0; i < 2; ++i) {
+		restored &= gpu_rd(s, 0xc00 + 4 * i) == s2cr[i] && gpu_rd(s, 0x800 + 4 * i) == smr[i];
+	}
+	printf("RAPHAEL GPU: context restored=%u detached=%u drained=%u; no DMA\n", restored, detached, drained);
+	return restored;
+}
