+static void
+gpu_update(vm_offset_t bank, unsigned off, uint32_t mask, uint32_t value)
+{
+	uint32_t old = gpu_rd(bank, off), next = (old & ~mask) | (value & mask);
+	if (old != next) { gpu_wr(bank, off, next); }
+}
