+/* Return a fixed board profile; never accept MMIO/PMIC addresses from boot args. */
+static int
+keys_board(void)
+{
+	DTEntry root;
+	const char *compatible;
+	unsigned size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (const void **)&compatible, &size) != kSuccess) {
+		return -1;
+	}
+	for (unsigned off = 0; off < size;) {
+		unsigned len = 0;
+		while (off + len < size && compatible[off + len]) {
+			++len;
+		}
+		if (off + len == size) {
+			break;
+		}
+		if (len == sizeof("xiaomi,raphael") - 1 && !memcmp(compatible + off, "xiaomi,raphael", len)) {
+			return 1;
+		}
+		if (len == sizeof("xiaomi,sweet") - 1 && !memcmp(compatible + off, "xiaomi,sweet", len)) {
+			return 0;
+		}
+		off += len + 1;
+	}
+	return -1;
+}
 
