+static void
+gpu_memory_test(vm_offset_t s)
+{
+	uint32_t id2 = s ? gpu_rd(s, 0x28) : 0;
+	unsigned oas = (id2 >> 4) & 15u;
+	if (!s || PAGE_SIZE != 0x4000 || !(id2 & (1u << 12)) || oas < 2 || oas > 5) {
+		printf("RAPHAEL GPU: memory test skipped: need 16K CPU / 4K SMMU / 40bit output\n");
+		return;
+	}
+	vm_offset_t v = 0;
+	kern_return_t kr = kmem_alloc_contig(kernel_map, &v, 2 * PAGE_SIZE, PAGE_MASK,
+	    ((1ull << 40) - 1) >> PAGE_SHIFT, 0, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) { printf("RAPHAEL GPU: memory allocation failed=%d\n", kr); return; }
+	ppnum_t pn = pmap_find_phys(kernel_pmap, v), tail = pmap_find_phys(kernel_pmap, v + PAGE_SIZE);
+	uint64_t pa = ptoa_64(pn), data = ptoa_64(tail);
+	bool owned = pn && tail && !(pa & PAGE_MASK) && data == pa + PAGE_SIZE &&
+	    data <= (1ull << 40) - PAGE_SIZE;
+	bool walked = false;
+	ArmSmmu4KResult result = {0};
+	ArmSmmu4KStatus status = ArmSmmu4KBadRange;
+	if (owned) {
+		ArmSmmu4KConfig config = {32, 40, pa, 4};
+		ArmSmmu4KRange range = {0x4000, data, PAGE_SIZE, ArmSmmu4KRead | ArmSmmu4KWrite, 0, 2};
+		uint64_t *tables = (uint64_t *)v;
+		status = ArmSmmu4KBuild(&config, &range, 1, tables, PAGE_SIZE / 4096, &result);
+		walked = status == ArmSmmu4KSuccess && result.table_pages == 3 && result.leaf_pages == 4;
+		for (unsigned i = 0; walked && i < 4; ++i) {
+			uint64_t va = 0x4000 + 4096 * i, at = 0;
+			for (unsigned level = result.start_level; level <= 3; ++level) {
+				uint64_t entry = tables[at * 512 + ((va >> (39 - 9 * level)) & 511)];
+				uint64_t p = entry & 0x0000fffffffff000ull;
+				if ((entry & 3) != 3) { walked = false; break; }
+				if (level == 3) { walked = p == data + 4096 * i; }
+				else {
+					if (p < pa || p - pa >= result.table_pages * 4096) { walked = false; break; }
+					at = (p - pa) / 4096;
+				}
+			}
+		}
+		if (walked) {
+			uint32_t *payload = (uint32_t *)(v + PAGE_SIZE);
+			for (unsigned i = 0; i < PAGE_SIZE / 4; ++i) { payload[i] = 0x64000000u ^ i; }
+			clean_dcache64(pa, 2 * PAGE_SIZE, TRUE);
+		}
+	}
+	printf("RAPHAEL GPU: memory owned=%u build=%u walked=%u tables=%lu leaves=%lu; inactive, no DMA\n",
+	    owned, status, walked, (unsigned long)result.table_pages, (unsigned long)result.leaf_pages);
+	kmem_free(kernel_map, v, 2 * PAGE_SIZE);
+}
