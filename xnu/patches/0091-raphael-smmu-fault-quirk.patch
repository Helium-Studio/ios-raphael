 static bool
+gpu_stream_fault(vm_offset_t s, unsigned slot)
+{
+	/* Linux qcom_smmu_write_s2cr: TZ may drop FAULT and convert BYPASS to FAULT.
+	 * Test only an invalid, exclusively owned slot; never publish a bypass route. */
+	if (gpu_rd(s, 0x800 + 4 * slot) & (1u << 31)) { return false; }
+	gpu_wr(s, 0xc00 + 4 * slot, 2u << 16);
+	uint32_t first = gpu_rd(s, 0xc00 + 4 * slot);
+	bool quirk = first != 0xffffffffu && (first & (3u << 16)) != (2u << 16);
+	if (quirk) { gpu_wr(s, 0xc00 + 4 * slot, (1u << 16) | 0xffu); }
+	uint32_t actual = gpu_rd(s, 0xc00 + 4 * slot);
+	bool faulted = actual != 0xffffffffu && (actual & (3u << 16)) == (2u << 16);
+	printf("RAPHAEL GPU: slot%u faulted=%u quirk=%u first=%#x actual=%#x\n", slot, faulted, quirk, first, actual);
+	return faulted;
+}
+
+static bool
+gpu_stream_restore(vm_offset_t s, unsigned slot, uint32_t value)
+{
+	gpu_wr(s, 0xc00 + 4 * slot, value);
+	if (gpu_rd(s, 0xc00 + 4 * slot) != value &&
+	    !(gpu_rd(s, 0x800 + 4 * slot) & (1u << 31)) && (value & (3u << 16)) == (2u << 16)) {
+		gpu_wr(s, 0xc00 + 4 * slot, (value & ~(3u << 16)) | (1u << 16));
+	}
+	return gpu_rd(s, 0xc00 + 4 * slot) == value;
+}
